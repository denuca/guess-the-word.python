# Q-Words Application Environment Configuration
# Copy this file to .env and update values for your environment

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
PORT=5000

# Proxy Configuration (for CloudFront/reverse proxy deployments)
APPLICATION_ROOT=/proxy/5000
PREFERRED_URL_SCHEME=https

# Session Security
SESSION_COOKIE_SECURE=false

# Word Repository Configuration
WORD_REPOSITORY_TYPE=local

# AWS Configuration (for DynamoDB repository)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=qwords-words
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
